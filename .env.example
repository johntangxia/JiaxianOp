# 复制为 .env 后按需修改（.env 不会提交到仓库）
#   cp .env.example .env

# 数据库账号。默认口令只适合演示，部署前请改掉
# （OpenGauss 要求口令同时包含大小写字母、数字和特殊字符）
GS_USERNAME=jiaxian_app
GS_PASSWORD=Jiaxian@2026

# 宿主机上暴露的端口：前端（Nginx）和后端（直接调接口用）
WEB_PORT=8090
API_PORT=8081

# 后端 JVM 参数
JAVA_OPTS=-XX:MaxRAMPercentage=75

# 后端容器的时区
TZ=Asia/Shanghai
